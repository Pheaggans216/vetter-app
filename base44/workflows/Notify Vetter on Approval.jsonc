{
  "name": "Notify Vetter on Approval",
  "description": "Sends an approval email to vetters when their profile status changes to active or approved.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"active\" or .trigger.data.status == \"approved\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "VetterProfile"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notify_vetter_on_approval",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "onVetterApproved",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "onVetterApproved"
  }
}